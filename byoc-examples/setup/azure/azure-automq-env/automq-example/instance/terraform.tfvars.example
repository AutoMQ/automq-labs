environment_id = "env-REPLACE_ME"
# Use a supported Data Plane version, not the Console 8.x version.
automq_version = "REPLACE_WITH_SUPPORTED_DATA_PLANE_VERSION"

kubernetes_cluster_id = "/subscriptions/SUBSCRIPTION_ID/resourceGroups/RESOURCE_GROUP/providers/Microsoft.ContainerService/managedClusters/AKS_NAME"
load_balancer_subnet_id = "/subscriptions/SUBSCRIPTION_ID/resourceGroups/NETWORK_RESOURCE_GROUP/providers/Microsoft.Network/virtualNetworks/VNET_NAME/subnets/PRIVATE_SUBNET_NAME"

# Use the Console's supported instance type and the existing AKS node pool.
instance_type  = "REPLACE_WITH_SUPPORTED_INSTANCE_TYPE"
node_pool_name = "automq"
zones          = ["REPLACE_WITH_ZONE_1", "REPLACE_WITH_ZONE_2", "REPLACE_WITH_ZONE_3"]
