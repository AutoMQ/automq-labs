        ],
        "Resource": [
          "arn:aws:fsx:<region>:<account-id>:file-system/*",
          "arn:aws:fsx:<region>:<account-id>:storage-virtual-machine/*",
          "arn:aws:fsx:<region>:<account-id>:volume/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:RequestTag/automqVendor": "automq"
          }
        }
      },
      {
        "Sid": "UpdateFSxTags",
        "Effect": "Allow",
        "Action": [
          "fsx:TagResource"
        ],
        "Resource": [
          "arn:aws:fsx:<region>:<account-id>:file-system/*",
          "arn:aws:fsx:<region>:<account-id>:storage-virtual-machine/*",
          "arn:aws:fsx:<region>:<account-id>:volume/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/automqVendor": "automq"
          },
          "StringEqualsIfExists": {
            "aws:RequestTag/automqVendor": "automq"
          }
        }
      },
      {
        "Sid": "RemoveFSxTags",
        "Effect": "Allow",
        "Action": [
          "fsx:UntagResource"
        ],
        "Resource": [
          "arn:aws:fsx:<region>:<account-id>:file-system/*",
          "arn:aws:fsx:<region>:<account-id>:storage-virtual-machine/*",
          "arn:aws:fsx:<region>:<account-id>:volume/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/automqVendor": "automq"
          },
          "ForAllValues:StringNotEquals": {
            "aws:TagKeys": [
              "automqVendor"
            ]
          }
        }
      },
      {
        "Sid": "ManageFSx",
        "Effect": "Allow",
        "Action": [
          "fsx:UpdateFileSystem",
          "fsx:DeleteFileSystem"
        ],
        "Resource": [
          "arn:aws:fsx:<region>:<account-id>:file-system/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/automqVendor": "automq"
          }
        }
      },
      {
        "Sid": "DeleteSVM",
        "Effect": "Allow",
        "Action": [
          "fsx:DeleteStorageVirtualMachine"
        ],
        "Resource": [
          "arn:aws:fsx:<region>:<account-id>:storage-virtual-machine/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/automqVendor": "automq"
          }
        }
      },
      {
        "Sid": "ManageFSxVolumes",
        "Effect": "Allow",
        "Action": [
          "fsx:UpdateVolume",
          "fsx:DeleteVolume"
        ],
        "Resource": [
          "arn:aws:fsx:<region>:<account-id>:volume/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/automqVendor": "automq"
          }
        }
      },
      {
        "Sid": "CreateServiceLinkedRolefsx",
        "Effect": "Allow",
        "Action": [
          "iam:CreateServiceLinkedRole"
        ],
        "Resource": [
          "*"
        ],
        "Condition": {
          "StringEquals": {
            "iam:AWSServiceName": "fsx.amazonaws.com"
          }
        }
      }
    ]
  },
  "pricing": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadPricing",
        "Effect": "Allow",
        "Action": [
          "pricing:DescribeServices",
          "pricing:GetAttributeValues",
          "pricing:GetProducts"
        ],
        "Resource": [
          "*"
        ]
      }
    ]
  }
}
