        "Resource": [
          "arn:aws:ec2:<region>:<account-id>:security-group/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/automqVendor": "automq"
          }
        }
      }
    ]
  },
  "eks": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ListOIDCProviders",
        "Effect": "Allow",
        "Action": [
          "iam:ListOpenIDConnectProviders"
        ],
