#!/bin/bash
set -euo pipefail

decode() {
  printf '%s' "$1" | base64 -d
}

retry() {
  local max_attempts="$1"
  shift
  local attempt=1

  until "$@"; do
    if [ "$attempt" -ge "$max_attempts" ]; then
      echo "Command failed after $${max_attempts} attempts: $*" >&2
      return 1
    fi
    sleep "$((attempt * 5))"
    attempt="$((attempt + 1))"
  done
}

AUTOMQ_CONFIG="$(decode '${automq_config_b64}')"
CONSOLE_IMAGE="$(decode '${console_image_b64}')"
INITIAL_PASSWORD="$(decode '${initial_password_b64}')"
INITIAL_ACCESS_KEY="$(decode '${initial_access_key_b64}')"
INITIAL_SECRET_KEY="$(decode '${initial_secret_key_b64}')"
DATA_VOLUME_ID="$(decode '${console_data_volume_id_b64}')"
DATA_VOLUME_SERIAL="$${DATA_VOLUME_ID//-/}"

retry 5 dnf install -y docker
systemctl enable --now docker

DATA_DEVICE=""
for attempt in $(seq 1 120); do
  for candidate in \
    "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${DATA_VOLUME_SERIAL}" \
    /dev/sdh \
    /dev/xvdh; do
    if [ -b "$candidate" ]; then
      DATA_DEVICE="$candidate"
      break 2
    fi
  done
  sleep 2
done

if [ -z "$DATA_DEVICE" ]; then
  echo "AutoMQ Console data volume did not appear" >&2
  exit 1
fi

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  mkfs.xfs -f "$DATA_DEVICE"
fi

mkdir -p /data
mountpoint -q /data || mount "$DATA_DEVICE" /data
DATA_UUID="$(blkid -s UUID -o value "$DATA_DEVICE")"
grep -q "UUID=$${DATA_UUID} /data " /etc/fstab || \
  echo "UUID=$${DATA_UUID} /data xfs defaults,nofail 0 2" >> /etc/fstab

install -m 0600 /dev/null /etc/automq-console.env
{
  printf 'CONFIG=%s\n' "$AUTOMQ_CONFIG"
  printf 'CONSOLE_INITIAL_USER=admin\n'
  printf 'CONSOLE_INITIAL_PASSWORD=%s\n' "$INITIAL_PASSWORD"
  printf 'CONSOLE_INITIAL_ACCESS_KEY=%s\n' "$INITIAL_ACCESS_KEY"
  printf 'CONSOLE_INITIAL_SECRET_KEY=%s\n' "$INITIAL_SECRET_KEY"
  printf 'CLOUD_PROVIDER=aws\n'
  printf 'ENABLE_USER_MANAGED_IAM=true\n'
  printf 'IAAS_SPOT_MODE=NONE\n'
} > /etc/automq-console.env

retry 5 docker pull "$CONSOLE_IMAGE"
docker rm -f automq-console >/dev/null 2>&1 || true
docker run -d \
  --name automq-console \
  --restart unless-stopped \
  --net=host \
  --log-driver json-file \
  --log-opt max-size=100m \
  --log-opt max-file=3 \
  -v /data:/root \
  --env-file /etc/automq-console.env \
  "$CONSOLE_IMAGE"

sleep 5
if [ "$(docker inspect --format '{{.State.Running}}' automq-console)" != "true" ]; then
  docker logs automq-console >&2 || true
  echo "AutoMQ Console container did not remain running" >&2
  exit 1
fi
