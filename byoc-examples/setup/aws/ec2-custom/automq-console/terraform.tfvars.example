# Paste the complete Base64 CONFIG value supplied by AutoMQ.
automq_config = "REPLACE_WITH_AUTOMQ_CONFIG"

# All other inputs have demo defaults. Override only when needed.
# name_prefix          = "automq-ec2-demo"
# vpc_cidr             = "10.42.0.0/16"
# console_image        = "automq.azurecr.io/automq/automq-byoc-console:8.3.16-aws"
# console_instance_type = "t3.large"

# By default Terraform detects the caller's public IPv4 address and allows /32.
# console_allowed_cidr_blocks = ["203.0.113.10/32"]

# Leave empty to create a disposable encrypted data bucket.
# data_bucket_name          = ""
# force_destroy_data_bucket = true
# force_destroy_ops_bucket  = true
