
variable "region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "resource_suffix" {
  description = "Suffix for resource names"
  type        = string
  default     = "automqlab"
}

variable "node_group" {
  description = "Configuration for EKS node group"
  type = object({
    name          = string
    ami_type      = string
    instance_type = string
    desired_size  = number
    max_size      = number
    min_size      = number
  })
  default = {
    name          = "automq-node-group"
    desired_size  = 4             # Desired number of nodes
    max_size      = 10            # Maximum number of nodes
    min_size      = 3             # Minimum number of nodes
    instance_type = "c6g.2xlarge" # Compute-optimized instance with AWS Graviton2 processor
    ami_type      = "AL2_ARM_64"  # Amazon Linux 2 AMI type, can use AL2_ARM_64 for ARM architecture
  }
}

variable "automq_console_config" {
  description = "Base64-encoded runtime configuration generated by the AutoMQ environment installation wizard."
  type        = string
  sensitive   = true

  validation {
    condition     = trimspace(var.automq_console_config) != ""
    error_message = "automq_console_config must contain the configuration generated by the AutoMQ installation wizard."
  }
}

variable "automq_console_role_arn" {
  description = "IAM role ARN associated with the AutoMQ Console ServiceAccount."
  type        = string

  validation {
    condition     = can(regex("^arn:aws:iam::[0-9]{12}:role/.+", var.automq_console_role_arn))
    error_message = "automq_console_role_arn must be an AWS IAM role ARN."
  }
}

variable "automq_console_namespace" {
  description = "Kubernetes namespace for the AutoMQ Console."
  type        = string
  default     = "automq-console"
}

variable "automq_console_service_account" {
  description = "Kubernetes ServiceAccount used by the AutoMQ Console."
  type        = string
  default     = "automq-console"
}

variable "automq_console_storage_class" {
  description = "StorageClass used for AutoMQ Console persistent data."
  type        = string
  default     = "gp3"
}

variable "automq_console_domain_name" {
  description = "DNS name exposed by the AutoMQ Console ALB."
  type        = string
}

variable "automq_console_acm_certificate_arn" {
  description = "ACM certificate ARN matching automq_console_domain_name."
  type        = string
}

variable "automq_console_chart_version" {
  description = "AutoMQ BYOC Console Helm chart version."
  type        = string
  default     = "8.3.7"
}
